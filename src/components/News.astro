---
import Section from './utils/Section.astro';
import NewsLi from './utils/NewsLi.astro';
import { infoArray } from '../news';
---

<Section id="info" title="【お知らせ】">
  <div class="grid-paper">
    <ul>
      {infoArray.map((info) => (
        <NewsLi {...info} />
      ))}
    </ul>
  </div>
</Section>

<style>
  .grid-paper {
    height: 200px;
    padding: 30px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  ul {
    width: fit-content;
    max-width: 1000px;
    height: 200px;
    overflow-y: scroll;
    -ms-overflow-style: none;
    scrollbar-width: none;
    margin: 0 auto;
    padding: 10px 0 30px 0;
    list-style: none;
    line-height: 2.5;
  }
  ul::-webkit-scrollbar {
    display: none;
  }
</style>
