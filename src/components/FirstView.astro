---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import mobileImage from '../assets/mobile.webp';
import pcImage from '../assets/pc.webp';
import logoImage from '../assets/logo.webp';

// landscape screens get the PC key visual, portrait screens the mobile one
const LANDSCAPE = '(min-aspect-ratio: 1/1)';
const FORMATS = ['avif', 'webp'] as const;
const WIDTHS = [640, 750, 828, 1080, 1280, 1668, 2048, 2560];

const buildSources = (image: ImageMetadata) =>
  Promise.all(
    FORMATS.map(async (format) => {
      const widths = WIDTHS.filter((width) => width <= image.width);
      const { srcSet } = await getImage({ src: image, format, widths });
      return { type: `image/${format}`, srcset: srcSet.attribute };
    })
  );

const [pcSources, mobileSources] = await Promise.all([buildSources(pcImage), buildSources(mobileImage)]);
const fallback = await getImage({ src: mobileImage, format: 'jpeg', width: 1080 });
---

<header class="key-visual-container" style={`--pc-aspect-ratio: ${pcImage.width} / ${pcImage.height}`}>
  <h1 class="visually-hidden">なついろにっき。</h1>
  <picture>
    {pcSources.map(({ type, srcset }) => (
      <source media={LANDSCAPE} type={type} srcset={srcset} sizes="100vw" />
    ))}
    {mobileSources.map(({ type, srcset }) => (
      <source type={type} srcset={srcset} sizes="100vw" />
    ))}
    <img
      class="key-visual"
      src={fallback.src}
      alt="なついろにっき。 キービジュアル"
      width={mobileImage.width}
      height={mobileImage.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="logo">
    <Picture
      src={logoImage}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      alt="なついろにっき。 ロゴ"
      layout="full-width"
      sizes="(min-aspect-ratio: 1/1) 60vw, 100vw"
      width={logoImage.width}
      height={logoImage.height}
      priority
    />
  </div>
  <div class="blur-box"></div>
</header>

<style>
  .key-visual-container {
    position: relative;
    height: 100lvh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }

  picture {
    display: contents;
  }

  .key-visual {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .logo {
    position: absolute;
    z-index: 2;
  }

  .blur-box {
    display: none;
  }

  /* Mobile Version */
  @media screen and (max-aspect-ratio: 1/1) {
    .key-visual {
      min-height: 100lvh;
    }

    .logo {
      top: 75%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 65%;
    }
  }
  @media screen and (max-aspect-ratio: 1/1) and (max-width: 930px) {
    .logo {
      width: 80%;
    }
  }
  @media screen and (max-aspect-ratio: 1/1) and (max-width: 700px) {
    .logo {
      width: 100%;
    }
  }

  /* PC Version */
  @media screen and (min-aspect-ratio: 1/1) {
    .key-visual {
      /* the img's width/height attributes describe the mobile image */
      aspect-ratio: var(--pc-aspect-ratio);
    }

    .logo {
      bottom: 20px;
      left: 20px;
      width: 50vw;
    }

    .blur-box {
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 300px;
      background: linear-gradient(to bottom, rgba(255, 251, 242, 0) 0%, rgba(255, 251, 242, 1) 100%);
      z-index: 1;
    }
  }
  @media screen and (min-aspect-ratio: 1/1) and (max-width: 1400px) {
    .logo {
      width: 55vw;
    }
  }
  @media screen and (min-aspect-ratio: 1/1) and (max-width: 1200px) {
    .logo {
      width: 60vw;
    }
  }
</style>
