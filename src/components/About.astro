---
import { Picture } from 'astro:assets';
import Section from './utils/Section.astro';
import GridCard from './utils/GridCard.astro';
import LinkButton from './utils/LinkButton.astro';
import establishImage from '../assets/establish.webp';

const circleUrl = 'https://kirinohanovel.com';

// icon paths from Bootstrap Icons (MIT)
const snsLinks = [
  {
    label: 'X',
    href: 'https://x.com/kirinohanovel/',
    iconPath:
      'M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/Kirinoha-Novel/',
    iconPath:
      'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8',
  },
];
---

<Section id="circle" title="【サークル紹介】">
  <GridCard>
    <div class="photo-wrapper">
      <Picture
        src={establishImage}
        class="photo"
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        width={480}
        height={480}
        widths={[240, 480]}
        sizes="240px"
        alt="きりのはのべる 発足"
      />
      {/* SNS stickers */}
      {snsLinks.map(({ label, href, iconPath }) => (
        <a class="sticker" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
          <svg class="sticker-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d={iconPath} />
          </svg>
        </a>
      ))}
    </div>
    <p class="description">
      同人美少女ゲーム制作サークル「きりのはのべる」です。
      <br />
      弊団体は筑波大生が集い、同人の美少女ゲーム/ノベルゲームを制作しています。
      筑波大学を飛び越えてみなさんに萌えをお届けします。
    </p>
    <LinkButton href={circleUrl}>サークルサイトへ</LinkButton>
  </GridCard>
</Section>

<style>
  .photo-wrapper {
    position: relative;
    isolation: isolate;
    width: 240px;
    margin: 20px auto 0 auto;
  }

  /* blue glue stick peeking out from under the photo */
  .photo-wrapper::before {
    content: '';
    position: absolute;
    inset: -5px -9px -7px -4px;
    z-index: -1;
    rotate: -2deg;
    border-radius: 46% 54% 40% 60% / 8% 12% 10% 6%;
    background:
      repeating-linear-gradient(-8deg, rgba(255, 255, 255, 0.35) 0 3px, transparent 3px 9px), rgba(150, 196, 255, 0.4);
  }

  /* photo glued flat with a glue stick */
  .photo {
    display: block;
    width: 100%;
    height: auto;
    box-sizing: border-box;
    border: 8px solid #ffffff;
    box-shadow:
      0 0 0 1px rgba(90, 82, 67, 0.08),
      0 1px 1px rgba(90, 82, 67, 0.12);
    rotate: -4deg;
  }

  /* die-cut round SNS stickers */
  .sticker {
    position: absolute;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 5px solid #ffffff;
    border-radius: 50%;
    color: var(--note-font-color);
    box-shadow:
      0 0 0 1px rgba(90, 82, 67, 0.12),
      0 3px 0 rgba(90, 82, 67, 0.14);
  }

  .sticker:nth-of-type(1) {
    right: 8px;
    bottom: -24px;
    background-color: var(--accent-blue);
    rotate: -10deg;
  }

  .sticker:nth-of-type(2) {
    right: -56px;
    bottom: -10px;
    background-color: var(--accent-lavender);
    rotate: 8deg;
  }

  /* keep the stickers on screen on very narrow phones */
  @media screen and (max-width: 359px) {
    .sticker:nth-of-type(1) {
      right: 56px;
    }

    .sticker:nth-of-type(2) {
      right: -8px;
    }
  }

  .sticker-icon {
    width: 26px;
    height: 26px;
  }

  .description {
    margin: 60px auto 40px auto;
    color: var(--note-font-color);
    font-size: var(--text-lg);
  }
</style>
