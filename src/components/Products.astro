---
import { Picture } from 'astro:assets';
import Section from './utils/Section.astro';
import GridCard from './utils/GridCard.astro';
import LinkButton from './utils/LinkButton.astro';
import dlsiteImage from '../assets/dlsite.webp';

const dlsiteUrl = 'https://www.dlsite.com/maniax/work/=/product_id/RJ01703526.html';
---

<Section id="product" title="【製品版情報】">
  <GridCard>
    <a class="image-link" href={dlsiteUrl} target="_blank" rel="noopener noreferrer">
      <Picture
        src={dlsiteImage}
        class="dlsite-img"
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        alt="なついろにっき。 DLsite 製品ページ"
        width={dlsiteImage.width}
        height={dlsiteImage.height}
      />
    </a>
    <p class="text">
      <span>「なついろにっき。」は</span>
      <span>DLsiteにて販売中です。</span>
    </p>
    <LinkButton href={dlsiteUrl}>DLsiteで見る</LinkButton>
  </GridCard>
</Section>

<style>
  .image-link {
    display: inline-block;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(90, 82, 67, 0.25);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .image-link:hover,
  .image-link:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(90, 82, 67, 0.35);
  }

  .dlsite-img {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
  }

  .text {
    margin: 50px auto 40px auto;
    color: var(--note-font-color);
    font-size: var(--text-xl);
  }
  .text span {
    display: inline-block;
    background: linear-gradient(transparent 70%, #66c7ff65 0%);
  }

  @media screen and (min-width: 700px) {
    .text {
      font-size: var(--text-2xl);
    }
  }

  @media screen and (max-width: 559px) {
    .text {
      margin: 30px auto 20px auto;
    }
    .text span {
      background: linear-gradient(transparent 75%, #66c7ff65 0%);
    }
  }
</style>
