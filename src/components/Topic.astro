---
import Section from './utils/Section.astro';
import GridCard from './utils/GridCard.astro';
import LinkButton from './utils/LinkButton.astro';
---

<Section id="topic" title="【トピック】">
  <GridCard>
    <p class="description">
      コミックマーケット C107 に出展しました！
      <br />
      「なついろにっき。」の体験版配布カードの配布などを行いました。
      立ち寄ってくださった皆さま、誠にありがとうございました。
    </p>
    <LinkButton href="https://kirinohanovel.com/c107">C107 特設サイトへ</LinkButton>
  </GridCard>
</Section>

<style>
  .description {
    margin: 0 auto 40px auto;
    color: var(--note-font-color);
    font-size: var(--text-xl);
  }
</style>
