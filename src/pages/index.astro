---
import { Header } from '../components/Header.tsx';
import { Loading } from '../components/Loading.tsx';
import LoadOverlay from '../components/LoadOverlay.astro';
import FirstView from '../components/FirstView.astro';
// import Topic from '../components/Topic.astro';
import News from '../components/News.astro';
import Story from '../components/Story.astro';
import Character from '../components/Character.astro';
import Movie from '../components/Movie.astro';
import Products from '../components/Products.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Header client:load />
  <Loading client:load />
  <LoadOverlay />
  <FirstView />
  <main>
    <!-- <Topic /> -->
    <News />
    <Story />
    <Character />
    <Movie />
    <Products />
    <About />
  </main>
  <Footer />
</Layout>

<style>
  main {
    margin: 0 auto;
    max-width: 1200px;
  }
</style>
